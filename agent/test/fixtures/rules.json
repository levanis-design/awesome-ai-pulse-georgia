{
  "$comment": "A frozen copy of config/rules.json (2026-10-21) for the tests. The owner edits the real file; tests that depend on a number read it from here, so changing a rule never breaks the apply step's own checks.",
  "repo": "tornikebolokadze1-cyber/awesome-ai-pulse-georgia",
  "thresholds": {
    "$minStarsNew": "a repo created within discoverWindowDays needs at least this many stars to be proposed",
    "minStarsNew": 5000,
    "$minStarsOld": "an older repo that is not listed yet (a 'big miss') needs at least this many",
    "minStarsOld": 20000,
    "discoverWindowDays": 60,
    "$floorIndependent": "rule of 2026-10-20: independent projects under ~3K stars leave the list; removal is proposed only below floorIndependent * floorSlack so a repo hovering at the line does not flap",
    "floorIndependent": 3000,
    "floorSlack": 0.9,
    "$minForkRatio": "forks/stars below this is a star-farming sign (every listed repo is above 0.018; the excluded DSH ecosystem sat near 0.0025)",
    "minForkRatio": 0.01,
    "minCommits": 20,
    "$staleMonths": "a repo not pushed for this long gets a dated 'no longer updated' note proposal",
    "staleMonths": 12,
    "maxNewPerScan": 8,
    "maxDescriptionReviewsPerScan": 5
  },
  "$vendorOwners": "official vendor connectors and vendor-lab releases stay regardless of stars (owner's rule of 2026-10-20)",
